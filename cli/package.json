{
  "name": "praxiflow",
  "version": "1.4.0",
  "bin": {
    "praxiflow": "./dist/index.js"
  },
  "license": "MIT",
  "scripts": {
    "dev": "ts-node ./src/index.ts",
    "prod": "node ./dist/index.js",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"require('node:fs').chmodSync('dist/index.js',0o755)\"",
    "test": "vitest run",
    "test:pro": "vitest run --exclude '.worktrees/**' tests/generator/pro*.test.ts",
    "test:watch": "vitest",
    "ui:generate": "node scripts/ui/generate.mjs",
    "ui:previews": "node scripts/ui/render-previews.mjs",
    "ui:gallery": "node scripts/ui/build-gallery.mjs",
    "ui:verify": "node scripts/ui/verify-generated.mjs",
    "ui:matrix": "node scripts/ui/matrix.mjs",
    "check": "npm run ui:gallery && npm run test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "files": [
    "dist/",
    "templates/",
    "!templates/designs/",
    "!templates/ui.shared/"
  ],
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "chalk": "^5.4.1",
    "chalk-animation": "^2.0.3",
    "figlet": "^1.8.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chalk-animation": "^1.6.3",
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "clsx": "^2.1.1",
    "motion": "^12.42.2",
    "next": "^16.2.10",
    "playwright": "1.62.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-wrap-balancer": "^1.1.1",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.5.4",
    "vitest": "4.1.11"
  }
}
