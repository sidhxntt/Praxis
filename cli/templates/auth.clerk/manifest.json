{
  "id": "auth.clerk",
  "overlays": [
    { "scope": "backend", "source": "files/typescript", "language": "typescript" },
    { "scope": "backend", "source": "files/javascript", "language": "javascript" },
    { "scope": "frontend", "source": "files/next-typescript", "language": "typescript", "framework": "next" },
    { "scope": "frontend", "source": "files/next-javascript", "language": "javascript", "framework": "next" },
    { "scope": "frontend", "source": "files/vite-typescript", "language": "typescript", "framework": "vite" },
    { "scope": "frontend", "source": "files/vite-javascript", "language": "javascript", "framework": "vite" }
  ],
  "packages": [
    { "scope": "backend", "dependencies": { "@clerk/express": "^1.7.54" } },
    { "scope": "frontend", "framework": "next", "dependencies": { "@clerk/nextjs": "^6.31.10" } },
    { "scope": "frontend", "framework": "vite", "dependencies": { "@clerk/clerk-react": "^5.54.0" } }
  ],
  "env": [
    { "scope": "backend", "keys": ["CLERK_SECRET_KEY"] },
    { "scope": "frontend", "framework": "next", "keys": ["NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY"] },
    { "scope": "frontend", "framework": "vite", "keys": ["VITE_CLERK_PUBLISHABLE_KEY"] }
  ],
  "patches": [
    { "scope": "backend", "file": "src/server.ts", "find": "// @praxis:imports", "replace": "// @praxis:imports\nimport { clerkMiddleware } from \"@clerk/express\";\nimport { requireAuth } from \"./auth/require-auth.js\";", "language": "typescript" },
    { "scope": "backend", "file": "src/server.ts", "find": "// @praxis:middleware", "replace": "// @praxis:middleware\napp.use(clerkMiddleware());\napp.get(\"/api/protected\", requireAuth, (_request, response) => response.json({ message: \"Protected route\" }));", "language": "typescript" },
    { "scope": "backend", "file": "src/server.js", "find": "// @praxis:imports", "replace": "// @praxis:imports\nimport { clerkMiddleware } from \"@clerk/express\";\nimport { requireAuth } from \"./auth/require-auth.js\";", "language": "javascript" },
    { "scope": "backend", "file": "src/server.js", "find": "// @praxis:middleware", "replace": "// @praxis:middleware\napp.use(clerkMiddleware());\napp.get(\"/api/protected\", requireAuth, (_request, response) => response.json({ message: \"Protected route\" }));", "language": "javascript" },
    { "scope": "frontend", "file": "app/layout.tsx", "find": "import \"./globals.css\";", "replace": "import \"./globals.css\";\nimport { AuthProvider } from \"../components/auth-provider\";", "language": "typescript", "framework": "next" },
    { "scope": "frontend", "file": "app/layout.tsx", "find": "<body>{children}</body>", "replace": "<body><AuthProvider>{children}</AuthProvider></body>", "language": "typescript", "framework": "next" },
    { "scope": "frontend", "file": "app/layout.jsx", "find": "import \"./globals.css\";", "replace": "import \"./globals.css\";\nimport { AuthProvider } from \"../components/auth-provider\";", "language": "javascript", "framework": "next" },
    { "scope": "frontend", "file": "app/layout.jsx", "find": "<body>{children}</body>", "replace": "<body><AuthProvider>{children}</AuthProvider></body>", "language": "javascript", "framework": "next" },
    { "scope": "frontend", "file": "src/main.tsx", "find": "import App from \"./App\";", "replace": "import App from \"./App\";\nimport { AuthProvider } from \"./auth-provider\";", "language": "typescript", "framework": "vite" },
    { "scope": "frontend", "file": "src/main.tsx", "find": "<App />", "replace": "<AuthProvider><App /></AuthProvider>", "language": "typescript", "framework": "vite" },
    { "scope": "frontend", "file": "src/main.jsx", "find": "import App from \"./App\";", "replace": "import App from \"./App\";\nimport { AuthProvider } from \"./auth-provider\";", "language": "javascript", "framework": "vite" },
    { "scope": "frontend", "file": "src/main.jsx", "find": "<App />", "replace": "<AuthProvider><App /></AuthProvider>", "language": "javascript", "framework": "vite" }
  ]
}
