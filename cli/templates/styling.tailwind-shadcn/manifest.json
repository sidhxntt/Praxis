  }],
  "patches": [{
    "scope": "frontend",
    "file": "vite.config.js",
    "find": "import react from \"@vitejs/plugin-react\";",
    "replace": "import react from \"@vitejs/plugin-react\";\nimport tailwindcss from \"@tailwindcss/vite\";",
    "framework": "vite"
  }, {
    "scope": "frontend",
    "file": "vite.config.js",
    "find": "plugins: [react()],",
    "replace": "plugins: [react(), tailwindcss()],",
    "framework": "vite"
  }, {
    "scope": "frontend",
    "file": "components.json",
    "find": "\"tsx\": true",
    "replace": "\"tsx\": false",
    "language": "javascript",
    "framework": "next"
  }, {
    "scope": "frontend",
    "file": "components.json",
    "find": "\"tsx\": true",
    "replace": "\"tsx\": false",
    "language": "javascript",
    "framework": "vite"
  }]
}
