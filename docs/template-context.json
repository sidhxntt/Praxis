{
  "schemaVersion": 1,
  "wikiBaseUrl": "https://github.com/sidhxntt/Praxis/wiki",
  "selections": {
    "projectTypes": ["frontend", "backend", "fullstack", "pro-backend"],
    "frontends": ["next", "vite", "vue", "astro", "angular"],
    "databases": ["postgres", "mongo", "none"],
    "auth": ["self-hosted", "clerk", "supabase", "none"],
    "cache": ["redis", "memcached", "none"],
    "deployments": ["vercel", "railway", "render", "docker"],
    "proStacks": ["python-django", "go-gin"],
    "clouds": ["aws", "azure", "gcp"]
  },
  "moduleFamilies": [
    { "prefix": "frontend.", "bundle": "standard-frontend" },
    { "prefix": "styling.", "bundle": "standard-ui" },
    { "prefix": "ui.", "bundle": "standard-ui" },
    { "prefix": "backend.", "bundle": "standard-express" },
    { "prefix": "base.", "bundle": "standard-fullstack" },
    { "prefix": "database.", "bundle": "standard-database" },
    { "prefix": "auth.", "bundle": "standard-auth" },
    { "prefix": "cache.", "bundle": "standard-cache" },
